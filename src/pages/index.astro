---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trace from '../components/Trace.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import photo from '../assets/shaun.jpg';
import { site } from '../data/site';
import { certs, issuer } from '../data/certs';
import { skills } from '../data/skills';
import { education } from '../data/education';

// Structured data. Only facts that appear on the page; no email.
const portrait = await getImage({ src: photo, width: 600, format: 'jpg' });
const abs = (path: string) => new URL(path, site.url).href;
const ids = {
  person: abs('/#person'),
  website: abs('/#website'),
  page: abs('/#profilepage'),
};

const school = (name: string) => ({
  '@type': name.includes('University') ? 'CollegeOrUniversity' : 'HighSchool',
  name,
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': ids.person,
      name: site.name,
      givenName: site.givenName,
      familyName: site.familyName,
      url: abs('/'),
      image: abs(portrait.src),
      jobTitle: site.jobTitle,
      affiliation: education
        .filter((e) => e.current)
        .map((e) => ({ ...school(e.school), ...(e.school === site.university.name ? { url: site.university.url } : {}) })),
      alumniOf: education.filter((e) => !e.current).map((e) => school(e.school)),
      knowsAbout: skills.flatMap((s) => s.items),
      sameAs: [site.linkedin, site.github],
      hasCredential: certs.map((c) => ({
        '@type': 'EducationalOccupationalCredential',
        name: c.fullName,
        credentialCategory: 'certification',
        educationalLevel: c.level,
        recognizedBy: { '@type': 'Organization', name: issuer.name, url: issuer.url },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': ids.website,
      url: abs('/'),
      name: site.name,
      description: site.description,
      inLanguage: site.lang,
      publisher: { '@id': ids.person },
    },
    {
      '@type': 'ProfilePage',
      '@id': ids.page,
      url: abs('/'),
      name: site.title,
      description: site.description,
      inLanguage: site.lang,
      isPartOf: { '@id': ids.website },
      mainEntity: { '@id': ids.person },
      about: { '@id': ids.person },
      primaryImageOfPage: { '@type': 'ImageObject', url: abs(site.ogImage.path), width: site.ogImage.width, height: site.ogImage.height },
    },
  ],
};
---
<Base title={site.title} description={site.description} path="/" jsonLd={jsonLd}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Trace />
    <Certifications />
    <Projects />
    <Skills />
    <Education />
    <Contact />
  </main>
  <Footer />
</Base>
