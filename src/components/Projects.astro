---
import { Picture } from 'astro:assets';
import Section from './Section.astro';
import { featured, more } from '../data/projects';
---
<Section id="projects" title="Projects">
  {featured.map((project, i) => (
    <article class="project">
      <figure class="project-shot">
        <Picture
          src={project.image}
          alt={project.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(max-width: 899px) calc(100vw - 2.5rem), (max-width: 1440px) 40vw, 600px"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="project-body">
        <p class="project-kicker mono">P.{String(i + 1).padStart(2, '0')} &middot; {project.kicker}</p>
        <h3>{project.name}</h3>
        <p>{project.summary}</p>
        <dl class="spec">
          <div><dt>Built with</dt><dd>{project.stack}</dd></div>
        </dl>
        <a class="text-link" href={project.url} target="_blank" rel="noopener">{project.linkText}</a>
      </div>
    </article>
  ))}

  <h3 class="sub-title">More projects</h3>
  <ul class="rows">
    {more.map((project) => (
      <li>
        <strong>{project.name}</strong>
        <span class="desc">{project.summary}</span>
        <span class="meta">{project.meta}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
/* ---------- Projects ---------- */
.project {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
  column-gap: var(--gap);
  align-items: start;
  padding-block: 0 clamp(3rem, 6vw, 5rem);
}

.project-shot :global(img) {
  width: 100%;
  border: 1px solid var(--ink);
  background: var(--paper-2);
}

.project-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.project-kicker {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--signal);
}

.project-body h3 {
  margin-top: -0.4rem;
}

.project-body > p:not(.project-kicker) {
  color: var(--ink-2);
  text-wrap: pretty;
}

.project-body .spec {
  border-bottom: 1px solid var(--rule);
}

.project-body .spec > div {
  grid-template-columns: 6.5rem 1fr;
  font-size: 0.9375rem;
}

.project-body .text-link {
  align-self: flex-start;
}

@media (max-width: 899px) {
  .project {
    grid-template-columns: 1fr;
    row-gap: 1.5rem;
  }
}

.sub-title {
  font: 400 0.75rem/1.6 var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-3);
  padding-bottom: 0.75rem;
}
</style>
