---
import { Picture } from 'astro:assets';
import photo from '../assets/shaun.jpg';
import { site, mailto } from '../data/site';
import { certs } from '../data/certs';
import { education } from '../data/education';

const degree = education.find((e) => e.current);
const certList = certs.map((c) => c.name);
const certified = `AWS ${certList.slice(0, -1).join(', ')}, ${certList.at(-1)}`;
---
<div class="wrap hero">
  <h1 class="hero-name"><span>{site.givenName}</span> <span>{site.familyName}</span></h1>

  <div class="hero-text">
    <p class="lead">{site.lead}</p>
    <div class="hero-actions">
      <a class="btn" href={mailto}>Email me</a>
      <a class="text-link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="text-link" href={site.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>

  <figure class="hero-photo">
    <Picture
      src={photo}
      alt={site.name}
      formats={['avif', 'webp']}
      widths={[300, 450, 600]}
      sizes="(max-width: 599px) 60vw, (max-width: 899px) 40vw, (max-width: 1440px) 22vw, 320px"
      priority
    />
    <figcaption><span class="mono">Fig. 01</span> {site.name}</figcaption>
  </figure>

  <dl class="spec hero-spec">
    {degree && (
      <div><dt>Study</dt><dd>{degree.qualification}, {degree.school}</dd></div>
    )}
    <div><dt>Certified</dt><dd>{certified}</dd></div>
    <div><dt>Looking for</dt><dd>{site.seeking}</dd></div>
  </dl>
</div>

<style>
/* ---------- Hero ---------- */
.hero {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  column-gap: var(--gap);
  padding-block: clamp(2.5rem, 6vw, 5rem) 0;
}

.hero-name {
  grid-column: 1 / span 9;
  grid-row: 1;
  align-self: end;
  font-size: clamp(4.25rem, 19vw, 19.5rem);
  font-weight: 700;
  font-stretch: 88%;
  line-height: 0.82;
  letter-spacing: -0.035em;
  margin-left: -0.04em; /* optical alignment of the S to the grid edge */
}

.hero-name span {
  display: block;
}

.hero-photo {
  grid-column: 10 / -1;
  grid-row: 1 / span 2;
  align-self: start;
}

.hero-photo :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: 50% 30%;
  filter: grayscale(1) contrast(1.05);
}

.hero-photo figcaption,
.project-shot figcaption {
  margin-top: 0.6rem;
  font: 400 0.75rem/1.5 var(--mono);
  color: var(--ink-3);
}

.hero-photo figcaption .mono {
  color: var(--signal);
  margin-right: 0.6em;
}

.hero-text {
  grid-column: 4 / span 6;
  grid-row: 2;
  padding-top: clamp(2rem, 4vw, 3.25rem);
}

.lead {
  font-size: clamp(1.25rem, 1.9vw, 1.625rem);
  font-weight: 400;
  line-height: 1.38;
  letter-spacing: -0.01em;
  max-width: 34ch;
  text-wrap: pretty;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem 1.75rem;
  margin-top: 2rem;
}

.hero-spec {
  grid-column: 4 / -1;
  grid-row: 3;
  margin-top: clamp(3rem, 6vw, 5rem);
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: var(--gap);
}

.hero-spec > div {
  grid-template-columns: 1fr;
  gap: 0.35rem;
  border-top-color: var(--ink);
  padding-top: 0.75rem;
}

.hero-spec dd {
  font-size: 0.9375rem;
  line-height: 1.45;
  text-wrap: balance;
}

@media (max-width: 899px) {
  .hero-name {
    grid-column: 1 / -1;
  }

  .hero-photo {
    grid-column: 1 / span 5;
    grid-row: 2;
    margin-top: 2rem;
  }

  .hero-text {
    grid-column: 6 / -1;
    grid-row: 2;
    padding-top: 2rem;
  }

  .hero-spec {
    grid-column: 1 / -1;
  }
}

@media (max-width: 599px) {
  .hero-name {
    font-size: 27vw;
  }

  .hero-photo {
    grid-column: 1 / span 7;
  }

  .hero-text {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  .hero-spec {
    grid-row: 4;
    grid-template-columns: 1fr;
  }

  .hero-spec > div {
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    border-top-color: var(--rule);
  }

  .hero-spec > div:first-child {
    border-top-color: var(--ink);
  }
}
</style>
